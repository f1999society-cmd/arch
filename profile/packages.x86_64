# bnasec 2.0.0 — Arch + Hyprland + ML4W dotfiles (mylinuxforwork/dotfiles 2.16)
# Every name is validated against configured repos by ci/build-iso.sh BEFORE
# the heavy build starts. Design: read-only root (no package rot, ever) +
# selective home-data persistence (see archiso_bnasec hook + bnasec-persist).

# --------------------------------------------------- base system
# base-devel is DELIBERATELY not shipped (v2.0.0 size): gcc/binutils/autoconf/
# bison/flex/groff/libtool/texinfo ≈ 300MB of tree for a live session where
# nothing compiles. The light runtime tools are listed explicitly instead —
# make/gawk stay for scripts that exec them.
base
make
gawk
patch
pkgconf
which
gettext
m4
linux
# split firmware subsets: the full linux-firmware bundle is ~700MB installed.
# intel/realtek/atheros/mediatek cover wifi; amdgpu covers AMD GPUs (v1.2.1 lesson)
linux-firmware-realtek
linux-firmware-atheros
linux-firmware-mediatek
linux-firmware-intel
linux-firmware-amdgpu
mkinitcpio
mkinitcpio-archiso
syslinux
e2fsprogs
zram-generator
sudo
git
curl
wget
unzip
vim
jq
pacman-contrib
usbutils
pciutils
dosfstools
ntfs-3g
exfatprogs
qemu-guest-agent
reflector
parted

# --------------------------------------------------- network
networkmanager
wpa_supplicant
network-manager-applet
nm-connection-editor
bluez
bluez-utils
openssh

# --------------------------------------------------- Hyprland session
hyprland
uwsm
hypridle
hyprsunset
hyprshutdown
xdg-user-dirs
hyprlock
hyprpicker
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
xorg-xwayland
polkit-gnome
gvfs-mtp

# --------------------------------------------------- ML4W dependency list (2.16)
# from setup/dependencies/packages-arch — all in official extra now
libnotify
qt5-wayland
qt6-wayland
gnome-themes-extra
python-pip
python-pipx
python-gobject
python-screeninfo
imagemagick
loupe
power-profiles-daemon
swaync
tesseract-data-eng
otf-font-awesome
ttf-firacode-nerd
ttf-jetbrains-mono-nerd
qt6-svg
qt6-virtualkeyboard
qt6-multimedia-ffmpeg
quickshell
# v3.0.0 ROOT-CAUSE FIX: the ML4W quickshell shell.qml instantiates
# WallpaperWindow which imports Qt5Compat.GraphicalEffects. That module lives
# in qt6-5compat — NOT a quickshell dependency and never shipped → the QML
# engine failed the import inside the ShellRoot → qs aborted on every boot →
# no bar, no dock, no wallpaper, on any hardware. ci/build-iso.sh now audits
# every Qt* import in the baked QML trees against the container's
# /usr/lib/qt6/qml tree so this class of bug can never ship again.
qt6-5compat
awww
matugen
nwg-displays
ttf-nerd-fonts-symbols
noto-fonts-emoji
noto-fonts
bibata-cursor-theme
grimblast-git

# --------------------------------------------------- ML4W companion tooling
# settings app setup.sh needs gum; build-tooling preinstalled
gum
make
gawk

# --------------------------------------------------- desktop utilities
rofi
# v3.0.0: fallback top bar — bnasec-session auto-starts waybar (ML4W glass
# theme) when quickshell cannot run; 'bnasec-bar switch' flips between them
# (Super+Ctrl+B). ML4W's own waybar themes ship with the dotfiles.
waybar
wlogout
kitty
thunar
tumbler
file-roller
grim
slurp
cliphist
wl-clip-persist
brightnessctl
playerctl
fastfetch
btop
firefox

# --------------------------------------------------- shell
zsh
eza
fzf

