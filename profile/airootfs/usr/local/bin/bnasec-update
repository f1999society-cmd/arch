#!/usr/bin/env bash
# bnasec-update v3.0.0 — the CORRECT way to install/upgrade on bnasec live.
#
# Why not plain `pacman -Syu`? The ISO is a snapshot: by the time you use it,
# mirror signers may have renewed their keys, so the baked keyring can report
# 'signature ... is unknown trust'. Refreshing the keyring packages FIRST and
# re-populating fixes trust in one deterministic flow (proven in CI):
#
#   1. refresh archlinux-keyring + chaotic-keyring from the mirrors
#   2. re-populate the trust db from the fresh keyring data
#   3. full sync upgrade (-Syu) + whatever extra packages were requested
#
# Usage:
#   bnasec-update                 # full system upgrade
#   bnasec-update libreoffice-fresh gimp   # upgrade + install these too
set -uo pipefail

log() { echo "[bnasec-update $(date +%H:%M:%S)] $*"; }

# ------------------------------------------------------- keyring bootstrap
# The stale snapshot trust db can hit a chicken-and-egg: even the NEW
# archlinux-keyring package fails verification ('unknown trust'). One
# SigLevel=Never transaction for the two keyring packages ONLY (both fetched
# over TLS from the configured mirrors), then a fresh populate fixes the
# web of trust for everything that follows. Proven in CI run 36283921325+.
log "refreshing keyrings (archlinux + chaotic)"
if ! sudo pacman -Sy --noconfirm archlinux-keyring chaotic-keyring; then
    log "signature bootstrap: upgrading keyring packages with SigLevel=Never (this transaction only)"
    sudo cp /etc/pacman.conf /tmp/pacman.conf.bak
    sudo sed -i 's/^SigLevel.*/SigLevel    = Never/' /tmp/pacman.conf.bak
    sudo pacman --config /tmp/pacman.conf.bak -Sy --noconfirm archlinux-keyring chaotic-keyring \
      && log "keyring packages upgraded"
    sudo rm -f /tmp/pacman.conf.bak
fi
sudo pacman-key --populate archlinux chaotic || true

log "full sync upgrade"
if [ "$#" -gt 0 ]; then
    sudo pacman -Syu --noconfirm --needed "$@"
else
    sudo pacman -Syu --noconfirm
fi
rc=$?
if [ "$rc" -eq 0 ]; then
    log "done. Everything landed in the persistent root — it survives reboots."
    /usr/local/bin/bnasec-space || true
else
    log "pacman exited with rc=$rc — check the output above"
fi
exit "$rc"
