#!/usr/bin/env bash
# shellcheck disable=SC2034

build() {
    # upstream archiso binaries (this hook is a self-contained fork of the
    # upstream archiso hook — HOOKS does not include the stock archiso hook).
    # WITHOUT add_binary losetup the initramfs falls back to busybox's applet,
    # which rejects GNU long options: "losetup: unrecognized option '--find'"
    # (boot test T1, run 36181737176) — and --show/--read-only too.
    add_module "loop"
    add_module "dm-snapshot"
    add_module "overlay"
    add_binary /usr/bin/losetup
    add_binary /usr/bin/blockdev
    add_binary /usr/bin/dmsetup
    add_binary /usr/bin/truncate
    add_binary /usr/bin/openssl
    add_binary /usr/bin/lsblk
    # bnasec persistence guarantee binaries (persist auto-create + fsck + reserve)
    add_binary /usr/bin/e2fsck
    add_binary /usr/bin/mkfs.ext4
    add_binary /usr/bin/tune2fs
    add_binary /usr/bin/sfdisk
    add_binary /usr/bin/partx
    add_binary /usr/bin/awk
    add_binary /usr/bin/sleep

    add_runscript
}

help() {
    cat <<HELPEOF
bnasec archiso hook (fork of upstream archiso)
  - auto-creates the persistence partition on the boot disk on first boot
    (mkfs.ext4 -m 0 -L persistence)
  - fscks the persistence partition on every boot (preen, escalating to -fy)
  - clears the ext4 root-reserved block pool (tune2fs -m 0)
  - falls back to a volatile session when persistence cannot be guaranteed
  - boot parameters: archisolabel=... cow_label=persistence cow_directory=persist
HELPEOF
}

